# --- Backend ---
# Comma-separated key pool, at least 2 keys. Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-api-key,your-second-api-key
# Any LiteLLM model name that matches the provider of your keys.
LLM_MODEL=gemini/gemini-3.5-flash-lite
# SQLite file (inside the Docker volume mounted at /data).
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (add your deployed frontend URL).
ALLOWED_ORIGINS=http://localhost:3000
# Enables the X-Simulate-Failure test header. Must be true on the deployed backend.
ENABLE_FAILURE_SIMULATION=true

# Optional
CACHE_ENABLED=true
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
MAX_HISTORY_MESSAGES=40
LLM_TIMEOUT_SECONDS=30

# --- Frontend (build time) ---
# URL of the backend as seen from the browser.
VITE_API_BASE_URL=http://localhost:8000
